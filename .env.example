# The Keys System - AI Engine Configuration
# Copy this file to .env and add your API keys for local development

# OpenAI API Key
# Get your key at: https://platform.openai.com/api-keys
# Required for: o1, o1-mini, GPT-4o, GPT-4o-mini, GPT-4 Turbo
VITE_OPENAI_API_KEY=sk-proj-...

# Anthropic API Key
# Get your key at: https://console.anthropic.com/settings/keys
# Required for: Claude 3.7 Sonnet, Claude 3.5 Sonnet, Claude 3.5 Haiku, Claude 3 Opus
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Google AI API Key (Gemini)
# Get your key at: https://aistudio.google.com/app/apikey
# Required for: Gemini 2.0 Flash, Gemini 2.0 Flash Thinking, Gemini 1.5 Pro, Gemini 1.5 Flash
VITE_GOOGLE_AI_API_KEY=AIza...

# Important Notes:
# - At least ONE API key is required for the app to function
# - Remove the '...' and add your actual API keys
# - Keep your .env file secure and never commit it to version control
# - When deployed to GitHub Spark, Spark runtime handles authentication automatically

