# Server-only configuration. Copy to .env; keep real values out of git.
# Core provider credentials (all three are required for the full Tri-Core flow).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Optional providers already supported by the app.
MISTRAL_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
HUGGINGFACE_API_KEY=
SERPER_API_KEY=
WOLFRAM_ALPHA_API_KEY=

# Required for production: at least 16 characters, and your exact HTTPS origin.
APP_ACCESS_PASSWORD=
APP_ORIGIN=
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_PORT=3001
DATABASE_PATH=./data/tri-core.sqlite
REQUESTS_PER_MINUTE=60
# Enable only behind one trusted reverse proxy that strips incoming forwarding headers.
TRUST_PROXY=0
